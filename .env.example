DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=generate-a-long-random-secret-before-deploying
DJANGO_ALLOWED_HOSTS=customer-signals.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://customer-signals.example.com
DATABASE_URL=postgresql://customer_signals:replace-this@localhost:5432/customer_signals
POSTGRES_DB=customer_signals
POSTGRES_USER=customer_signals
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
REDIS_PASSWORD=replace-with-a-long-random-value
CELERY_BROKER_URL=redis://:replace-with-a-long-random-value@localhost:6379/0
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

# Set only when an approved email provider is configured and sending is authorized.
ACTION_DELIVERY_ENABLED=false
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-this
EMAIL_HOST_PASSWORD=replace-this
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Customer Signals <noreply@example.com>

# Bootstrap an operator explicitly; never commit the real values.
DJANGO_SUPERUSER_USERNAME=admin@example.com
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=use-a-unique-long-password
